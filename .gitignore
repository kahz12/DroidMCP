# Binaries
bin/
release/

# Stray `go build` output at the repo root (one per cmd/ server). Keep in sync
# with SERVICES in the Makefile and scripts/build-arm64.sh.
/clipboard
/contacts
/filesystem
/github
/llmproxy
/media
/network
/notifications
/scraper
/sensors
/sms
/sqlite
/termux
# Makefile and CI name their output droidmcp-<service>; the CI matrix builds it
# in the workspace root before uploading.
/droidmcp-*
*.exe
*.exe~
*.dll
*.so
*.dylib
__debug_bin*

# Test, coverage and benchmark output
*.test
*.out
*.prof
coverage.html

# Dependency directories
vendor/

# Go workspace files are machine-local
go.work
go.work.sum

# Credentials and local config: GITHUB_TOKEN, DROIDMCP_*_KEY and the TLS
# cert/key from docs/security.md live in the environment, never in the repo.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx

# Local runtime data (network inventory, sqlite databases, logs)
*.log
*.db
*.sqlite
*.sqlite3
# SQLite journal / WAL sidecars that sit next to a database file
*.db-*
*.sqlite-*
*.sqlite3-*
network-devices.json
# Temp files left behind when a process dies mid-write (inventory persist,
# export_csv staging file)
network-devices.json.tmp
.droidmcp-export-*.csv

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
